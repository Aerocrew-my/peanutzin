# Public: required in development and production. Supabase project URL; public by design.
# Missing: local fallback content is used only outside production; production content fails closed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public: required in development and production. Supabase publishable/anon key; public by design.
# Missing: authentication and data access are unavailable; production content fails closed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Public: optional in development, required in production. Canonical HTTPS site origin, no path.
# Missing: localhost is used in development; production build fails to prevent incorrect SEO URLs.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Server-only: required for checkout/order creation in all deployed environments.
# Missing: checkout returns a secure-unavailable response. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only: development only. Use test to exercise simulated confirmation; omit in production.
# Production ignores test mode and leaves payment provider unconfigured.
PAYMENT_MODE=test

# Server-only: optional. Enables AI generation; manual Social Studio editing remains available.
OPENAI_API_KEY=your-server-only-openai-api-key

# Server-only: optional. OpenAI model name; defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Server-only: optional until Make.com is configured. Missing: automated publishing fails safely.
MAKE_SOCIAL_WEBHOOK_URL=https://hook.example.make.com/your-webhook

# Server-only: required with Make.com publishing. Long random bearer secret used to verify callbacks.
# Missing: callbacks are rejected; never place social-platform credentials in this repository.
MAKE_SOCIAL_CALLBACK_SECRET=replace-with-a-long-random-secret

# Test/script-only: optional local base URL for live route checks.
PEANUTZIN_APP_URL=http://127.0.0.1:3010

# Test/script-only: optional local test accounts. Never use client production passwords.
PEANUTZIN_TEST_ADMIN_EMAIL=admin-test@example.com
PEANUTZIN_TEST_ADMIN_PASSWORD=replace-with-test-password
PEANUTZIN_TEST_NONADMIN_EMAIL=nonadmin-test@example.com
PEANUTZIN_TEST_NONADMIN_PASSWORD=replace-with-test-password
